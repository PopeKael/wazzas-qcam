<?xml version="1.0" encoding="utf-8"?>
<!-- Modified for Wazza's QCam by Warren Gerdes, 2026. See LICENSE and NOTICE. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101318"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/scriptPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/status_ready"
                    android:textColor="#B8C0CC"
                    android:textSize="12sp" />
            </LinearLayout>
            <Button
                android:id="@+id/themeToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="72dp"
                android:text="@string/theme_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/newButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/new_script_button"
                android:textSize="11sp" />
            <Button
                android:id="@+id/pasteButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/paste_script"
                android:textSize="12sp" />
            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/save_script"
                android:textSize="12sp" />
            <Button
                android:id="@+id/openButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/open_script"
                android:textSize="12sp" />
            <Button
                android:id="@+id/fontSmallerButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/font_decrease"
                android:textSize="16sp" />
            <Button
                android:id="@+id/fontLargerButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/font_increase"
                android:textSize="16sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/scriptEdit"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/input_background"
            android:fadeScrollbars="false"
            android:gravity="top|start"
            android:hint="@string/script_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:textColor="#FFFFFF"
            android:textColorHint="#89929F"
            android:textSize="34sp"
            android:lineSpacingExtra="5dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cameraPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#0E1115">

        <com.wordhint.teleprompter.CameraPreviewStage
            android:id="@+id/cameraPreviewStage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/preview_unavailable">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@android:color/transparent"
                app:implementationMode="compatible"
                app:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/brightnessButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/camera_tool_button"
                android:contentDescription="@string/brightness_control"
                android:padding="12dp"
                android:src="@drawable/ic_brightness" />

            <com.wordhint.teleprompter.AudioLevelGraphView
                android:id="@+id/micStatusText"
                android:layout_width="76dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="4dp"
                android:background="@drawable/camera_tool_button"
                android:padding="5dp" />

            <ImageButton
                android:id="@+id/openVideoButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="54dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/camera_tool_button"
                android:contentDescription="@string/open_video"
                android:padding="12dp"
                android:src="@drawable/ic_open_video" />

            <TextView
                android:id="@+id/recordTimerText"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/camera_tool_button"
                android:gravity="center"
                android:text="@string/record_timer_initial"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/camera_tool_button"
                android:contentDescription="@string/settings_access"
                android:padding="12dp"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/cameraFlipButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/camera_tool_button"
                android:contentDescription="@string/switch_camera"
                android:padding="10dp"
                android:src="@drawable/ic_camera_flip" />

            <ImageButton
                android:id="@+id/recordButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="5dp"
                android:background="@drawable/record_control_background"
                android:contentDescription="@string/start_recording"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_record_idle" />
        </com.wordhint.teleprompter.CameraPreviewStage>
    </FrameLayout>
</LinearLayout>
